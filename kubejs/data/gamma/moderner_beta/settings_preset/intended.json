  "biomeSettings": {
    "moderner_beta:provider": "moderner_beta:fractal",
    "moderner_beta:temperature_height_scaling": "major_release",
    "moderner_beta:use_32bit_layer_seed": false,
    "moderner_beta:fractal_layers": {
      "outputs": {
        "moderner_beta:biome": "land"
      },
      "pipeline": [

        // ── 1. LAND SKELETON ─────────────────────────────────────────
        {
          "type": "moderner_beta:init_land",
          "id": "land",
          "seed": 1,
          "landChance": 10
        },
        {
          "type": "moderner_beta:fuzzy_zoom",
          "parent": "land",
          "id": "land",
          "seed": 2000
        },
        {
          "type": "moderner_beta:add_land",
          "parent": "land",
          "id": "land",
          "seed": 1,
          "betaShape": false,
          "land": "minecraft:plains",
          "ocean": "minecraft:ocean",
          "landChance": 3,
          "oceanChance": 16
        },
        {
          "type": "moderner_beta:modal_zoom",
          "parent": "land",
          "id": "land",
          "seed": 2001
        },
        {
          "type": "moderner_beta:add_land",
          "parent": "land",
          "id": "land",
          "seed": 2,
          "betaShape": false,
          "land": "minecraft:plains",
          "ocean": "minecraft:ocean",
          "landChance": 3,
          "oceanChance": 16
        },
        {
          "type": "moderner_beta:modal_zoom",
          "parent": "land",
          "id": "land",
          "seed": 2002
        },
        {
          "type": "moderner_beta:add_land",
          "parent": "land",
          "id": "land",
          "seed": 3,
          "betaShape": false,
          "land": "minecraft:plains",
          "ocean": "minecraft:ocean",
          "landChance": 3,
          "oceanChance": 16
        },

        // ── 2. MUSHROOM ISLAND ────────────────────────────────────────
        {
          "type": "moderner_beta:conditional_overlay",
          "parent": "land",
          "id": "land",
          "seed": 5,
          "predicate": {
            "condition": "moderner_beta:all_of",
            "terms": [
              { "condition": "moderner_beta:single_match", "biome": "minecraft:ocean" },
              { "condition": "moderner_beta:identical_neighbor", "diagonal": true, "requiredCount": 4 },
              { "condition": "moderner_beta:random_chance", "numerator": 1, "denominator": 100 }
            ]
          },
          "onMatch":   { "type": "biome", "value": "minecraft:mushroom_fields" },
          "otherwise": { "type": "biome", "value": "minecraft:the_void*null" }
        },

        // ── 3. BIOME POOLS ────────────────────────────────────────────

        // CHANGED: removed cornflower_grove, still_woods, flower_forest —
        // they are now handled as rare mutations in step 5 instead
        {
          "type": "moderner_beta:random_biome",
          "id": "biome_pool_common",
          "seed": 200,
          "biomes": [
            "minecraft:forest",
            "minecraft:dark_forest",
            "minecraft:birch_forest",
            "minecraft:old_growth_birch_forest",
            "minecraft:jungle",
            "minecraft:swamp",
            "minecraft:taiga",
            "minecraft:plains",
            "gamma:andesite_crags",
            "gamma:radiant_forest"
          ]
        },
        {
          "type": "moderner_beta:random_biome",
          "id": "biome_pool_cold",
          "seed": 201,
          "biomes": [
            "minecraft:snowy_plains",
            "minecraft:grove",
            "gamma:snow_world"
          ]
        },
        {
          "type": "moderner_beta:weighted_pool",
          "id": "biome_pool_taiga_rare",
          "seed": 202,
          "targets": [
            { "weight": 1, "data": { "type": "biome", "value": "minecraft:old_growth_pine_taiga" } },
            { "weight": 1, "data": { "type": "biome", "value": "minecraft:old_growth_spruce_taiga" } }
          ]
        },
        // ADDED: rare mutation pools for the three common mutated biomes
        {
          "type": "moderner_beta:constant_biome",
          "id": "biome_pool_forest_rare",
          "seed": 203,
          "biome": "minecraft:flower_forest"
        },
        {
          "type": "moderner_beta:constant_biome",
          "id": "biome_pool_dark_forest_rare",
          "seed": 204,
          "biome": "gamma:cornflower_grove"
        },
        {
          "type": "moderner_beta:constant_biome",
          "id": "biome_pool_birch_rare",
          "seed": 205,
          "biome": "gamma:still_woods"
        },
        {
          "type": "moderner_beta:weighted_pool",
          "id": "biome_pool_main",
          "seed": 206,
          "targets": [
            { "weight": 3, "data": { "type": "layer", "value": "biome_pool_common" } },
            { "weight": 1, "data": { "type": "layer", "value": "biome_pool_cold" } }
          ]
        },

        // ── 4. ASSIGN BIOMES TO LAND ──────────────────────────────────
        {
          "type": "moderner_beta:biome_replacement",
          "parent": "land",
          "id": "land",
          "seed": 0,
          "targets": {
            "minecraft:plains": { "type": "layer", "value": "biome_pool_main" }
          }
        },

        // ── 5. MUTATED VARIANTS ───────────────────────────────────────
        // CHANGED: now handles all four mutation cases consistently.
        // Each base biome has a 1-in-8 chance to promote to its mutated variant.
        {
          "type": "moderner_beta:predicate_overlay",
          "parent": "land",
          "id": "land",
          "seed": 300,
          "targets": [
            {
              "predicate": {
                "condition": "moderner_beta:all_of",
                "terms": [
                  { "condition": "moderner_beta:single_match", "biome": "minecraft:taiga" },
                  { "condition": "moderner_beta:random_chance", "numerator": 1, "denominator": 8 }
                ]
              },
              "result": "biome_pool_taiga_rare",
              "type": "layer"
            },
            {
              "predicate": {
                "condition": "moderner_beta:all_of",
                "terms": [
                  { "condition": "moderner_beta:single_match", "biome": "minecraft:forest" },
                  { "condition": "moderner_beta:random_chance", "numerator": 1, "denominator": 3 }
                ]
              },
              "result": "biome_pool_forest_rare",
              "type": "layer"
            },
            {
              "predicate": {
                "condition": "moderner_beta:all_of",
                "terms": [
                  { "condition": "moderner_beta:single_match", "biome": "minecraft:dark_forest" },
                  { "condition": "moderner_beta:random_chance", "numerator": 1, "denominator": 4 }
                ]
              },
              "result": "biome_pool_dark_forest_rare",
              "type": "layer"
            },
            {
              "predicate": {
                "condition": "moderner_beta:all_of",
                "terms": [
                  { "condition": "moderner_beta:single_match", "biome": "minecraft:birch_forest" },
                  { "condition": "moderner_beta:random_chance", "numerator": 1, "denominator": 4 }
                ]
              },
              "result": "biome_pool_birch_rare",
              "type": "layer"
            }
          ]
        },

        // ── 6. SCALE UP ───────────────────────────────────────────────
        // CHANGED: level bumped from 2 → 3 to make biomes larger
        {
          "type": "moderner_beta:stacked_zoom",
          "parent": "land",
          "id": "land",
          "seed": 1000,
          "level": 3,
          "seedModifier": 1,
          "zoomType": "modal"
        },

        // ── 7. DEEP OCEAN ─────────────────────────────────────────────
        /*
        {
          "type": "moderner_beta:conditional_overlay",
          "parent": "land",
          "id": "land",
          "seed": 0,
          "predicate": {
            "condition": "moderner_beta:all_of",
            "terms": [
              { "condition": "moderner_beta:single_match", "biome": "minecraft:ocean" },
              { "condition": "moderner_beta:identical_neighbor", "diagonal": false, "requiredCount": 4 }
            ]
          },
          "onMatch":   { "type": "biome", "value": "minecraft:deep_ocean" },
          "otherwise": { "type": "biome", "value": "minecraft:the_void*null" }
        },
        */

        // ── 8. FINAL ZOOM + SMOOTH ────────────────────────────────────
        {
          "type": "moderner_beta:stacked_zoom",
          "parent": "land",
          "id": "land",
          "seed": 1002,
          "level": 2,
          "seedModifier": 1,
          "zoomType": "modal"
        },
        {
          "type": "moderner_beta:smooth",
          "parent": "land",
          "id": "land",
          "seed": 1000
        },

        // ── 9. RIVER ──────────────────────────────────────────────────
        {
          "type": "moderner_beta:init_river",
          "parent": "land",
          "id": "river",
          "seed": 100
        },
        {
          "type": "moderner_beta:stacked_zoom",
          "parent": "river",
          "id": "river",
          "seed": 1000,
          "level": 6,
          "seedModifier": 1,
          "zoomType": "modal"
        },
        {
          "type": "moderner_beta:compute_river",
          "parent": "river",
          "id": "river",
          "seed": 0,
          "convertOceans": false
        },
        {
          "type": "moderner_beta:smooth",
          "parent": "river",
          "id": "river",
          "seed": 1000
        },

        // ── 10. MIX RIVERS ────────────────────────────────────────────
        {
          "type": "moderner_beta:mix_river",
          "parent": "land",
          "id": "land",
          "seed": 0,
          "riverSource": "river",
          "ignoredBiomes": [
            "minecraft:deep_ocean",
            "minecraft:ocean"
          ],
          "biomeSpecificRivers": {
            "minecraft:mushroom_fields":       "minecraft:mushroom_fields*shore",
            "minecraft:mushroom_fields*shore": "minecraft:mushroom_fields*shore"
          }
        },

        // ── 11. FROZEN RIVER ──────────────────────────────────────────
        {
          "type": "moderner_beta:predicate_overlay",
          "parent": "land",
          "id": "land",
          "seed": 400,
          "targets": [
            {
              "predicate": {
                "condition": "moderner_beta:all_of",
                "terms": [
                  { "condition": "moderner_beta:single_match", "biome": "minecraft:river" },
                  {
                    "condition": "moderner_beta:neighbor_match",
                    "requiredCount": 1,
                    "diagonal": false,
                    "neighborPredicate": {
                      "condition": "moderner_beta:in_set",
                      "biomes": [
                        "minecraft:snowy_plains",
                        "minecraft:grove",
                        "gamma:snow_world"
                      ]
                    }
                  }
                ]
              },
              "result": "minecraft:frozen_river",
              "type": "biome"
            }
          ]
        }

      ]
    }
  },
  "caveBiomeSettings": {
    "moderner_beta:provider": "moderner_beta:voronoi",
    "moderner_beta:cave_biome_voronoi": {
      "horizontalScale": 82,
      "verticalScale": 16,
      "depthMinY": -64,
      "depthMaxY": 64,
      "points": [
        {
          "biome": "gamma:underground",
          "temp": 0.0,
          "rain": 0.5,
          "depth": 0.75
        }
      ],
      "horizontalScale": 32.0,
      "verticalScale": 16.0
    }
  }
}